# ---------------------------------------------------------------------------
# Copy this file to `.env` at the project root and fill in real values.
# Never commit the real `.env` file and never store production secrets here.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://agencyflow_user:change_me@localhost:5432/agencyflow?schema=public"

# Backend server
PORT=5000
NODE_ENV=development
# Origin of the frontend, used for CORS and cookie settings.
CLIENT_URL="http://localhost:5173"

# Authentication. Replace JWT_SECRET with a long, unique, random value.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="agencyflow_session"

# Administrator account created by the seed script.
# `npm run prisma:seed --workspace=backend`
ADMIN_NAME="AgencyFlow Administrator"
ADMIN_EMAIL="admin@agencyflow.local"
ADMIN_PASSWORD="change-this-development-password"
